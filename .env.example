# Core
# Required for direct npm/Prisma commands. Docker Compose constructs its own
# value from the POSTGRES_* settings below.
DATABASE_URL=""
POSTGRES_DB="contract_hub"
POSTGRES_USER="contract_hub"
POSTGRES_PASSWORD=""
APP_PORT="3000"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Optional Google Workspace login. Credentials login remains available for seeded users.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Standard aliases are also supported instead of the AUTH_GOOGLE_* names.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GOOGLE_WORKSPACE_DOMAIN=""

# Google Drive integration: mock | oauth | service_account
GOOGLE_DRIVE_MODE="mock"
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
GOOGLE_SHARED_DRIVE_ID=""

# Personal My Drive OAuth. CONNECT-GOOGLE.bat fills these on Windows.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=""
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=""
GOOGLE_DRIVE_OAUTH_REDIRECT_URI="http://localhost:3000/api/admin/google-drive/callback"
# Optional. AUTH_SECRET is used when this is blank.
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# App
NEXT_PUBLIC_APP_NAME="مركز إدارة التعاقدات"
CONTRACT_RATE_LIMIT_PER_MINUTE="5"
LOG_LEVEL="info"

# Optional password reset email. Without SMTP, an administrator can still copy
# a 30-minute reset link from the Users page.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Required only when running npm run db:seed. Never reuse a production password.
SEED_PASSWORD=""
